#!/bin/sh
# The fixture's gh (SHEPHERD_MOCK): the review-panel branch has PR #42 (its timeline and diff too), the others none;
# the viewer is freethinkel.
# @NOW@ and @AGO@ in pr-42.json become the current time and five minutes before, so the running check reads right.
dir=$(dirname "$0")
case "$1 $2" in
  "api user") echo freethinkel ;;
  "pr view")
    case "$3" in
      42) cat "$dir/pr-42-timeline.json" ;;
      review-panel) sed -e "s/@NOW@/$(date -u +%Y-%m-%dT%H:%M:%SZ)/" -e "s/@AGO@/$(date -u -v-5M +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -d "-5 min" +%Y-%m-%dT%H:%M:%SZ)/" "$dir/pr-42.json" ;;
      *) echo "no pull requests found for branch \"$3\"" >&2; exit 1 ;;
    esac ;;
  "pr diff") cat "$dir/pr-42.diff" ;;
  *) exit 1 ;;
esac
