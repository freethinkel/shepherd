-    let out = cli(&args[0], &args[1..], dir).map_err(|e| e.to_string())?;
+    let rest: Vec<&str> = args[1..].iter().map(String::as_str).collect();
+    let out = cli(&args[0], &rest, dir).map_err(|e| e.to_string())?;
     if out.status.success() {
         return Ok(());
     }
