+/// The calls that retry a page's failed jobs: one per run on GitHub, one per job on GitLab.
+pub fn retry_failed(checks: &[Check], gitlab: bool) -> Vec<Vec<String>> {
+    let failed = checks.iter().filter(|c| c.state == CheckState::Failed);
+    if gitlab {
+        return failed.filter_map(|c| c.command(true, Action::Retry)).collect();
+    }
+    let mut runs: Vec<String> = failed.filter_map(|c| c.run.clone()).collect();
+    runs.dedup();
+    runs.into_iter().map(|run| ["gh", "run", "rerun", &run, "--failed"].map(String::from).to_vec()).collect()
+}
+
 /// Runs one CLI call in `dir`.
